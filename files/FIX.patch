+// Retained criterion ratings are sources even when no statement quotes them.
+export async function checkRetainedDebriefAuthority() {
+  const h = await businessHarness()
+  const managerEmail = address('42-retained-manager'), peerEmail = address('42-retained-peer')
+  try {
+    const manager = await h.member(managerEmail, ['manager'], 'Synthetic retained manager')
+    const peer = await h.member(peerEmail, ['interviewer'], 'Synthetic retained peer')
+    const job = await h.command('vacancy', { title: 'Synthetic retained feedback', location: 'New York', headcount: 1,
+      manager: managerEmail, compensation: { currency: 'USD', min: 100, max: 200, period: 'year' } }, manager)
+    await h.command('rubric', { id: job.id, criteria: [{ name: 'Work evidence', description: 'Explains previous work' }] }, manager)
+    await h.command('interview-plan', { id: job.id, plan: [{ name: 'Work review', stageName: 'Interview' }] }, manager)
+    const ownerEmail = (await h.state()).members.find(row => row.owner).email
+    const approval = await h.command('request-vacancy-approval', { id: job.id, approver: ownerEmail }, manager)
+    await h.command('decide-approval', { id: approval.id, decision: 'approved', version: approval.version, reason: 'Approved budget' })
+    const published = await h.command('publish', { id: job.id }, manager)
+    const criterion = published.rubrics[0].criteria[0].id
+    const { application } = await h.command('candidate', { name: 'Synthetic retained candidate', email: address('42-retained-candidate'),
+      source: 'Direct', consentBasis: 'manual', vacancy: job.id }, manager)
+    await h.command('assign-reviewers', { application: application.id, reviewers: [managerEmail, peerEmail] }, manager)
+    const ownQuote = 'Explained the original drawings in a factual example.'
+    const own = await h.command('scorecard', { application: application.id, ratings: { [criterion]: 3 },
+      evidence: { [criterion]: ownQuote }, recommendation: 'yes', takeaways: 'Specific work example', submit: true }, manager)
+    const other = await h.command('scorecard', { application: application.id, ratings: { [criterion]: 4 },
+      evidence: { [criterion]: 'Explained a separate completed work example.' }, recommendation: 'yes', takeaways: 'Another work example', submit: true }, peer)
+    await h.command('release-feedback', { application: application.id }, manager)
+    const statements = [{ kind: 'evidence', criterion, text: 'The interviewer described the original drawings.',
+      citations: [{ scorecard: own.id, criterion, field: 'evidence', quote: ownQuote }] }]
+    const brief = await h.command('debrief', { application: application.id, statements }, manager)
+    await h.command('decide-debrief', { id: brief.id, decision: 'keep' }, manager)
+    assert.deepEqual(brief.criteria[0].ratings.map(row => [row.scorecard, row.author, row.rating]),
+      [[own.id, managerEmail, 3], [other.id, peerEmail, 4]])
+    assert.deepEqual(brief.statements[0].citations.map(row => row.scorecard), [own.id], 'the peer is uncited')
+    let sequence = 0
+    const bulk = async () => {
+      const action = { kind: 'export' }, items = [application.id]
+      const preview = await h.command('bulk-preview', { items, action }, manager)
+      assert.equal(preview.items[0].ok, true)
+      const applied = await h.command('bulk-apply', { items, action, batch: 'synthetic-lodge-retained-' + (++sequence),
+        previewed: { [application.id]: preview.items[0].seen } }, manager)
+      assert.equal(applied.applied, 1)
+      return applied.file.items[0]
+    }
+    const allowed = await bulk()
+    assert.deepEqual(allowed.debriefs.map(row => row.id), [brief.id], 'authorized retained feedback remains exportable')
+    assert.deepEqual(allowed.debriefs[0].criteria, brief.criteria)
+    const level = await h.command('permission-level', { name: 'Retained feedback without peer access', permissions: ['export', 'contact'] })
+    await h.command('job-levels', { id: job.id, members: { [managerEmail]: level.id } })
+    await h.restart()
+    const view = await h.state(manager)
+    assert.ok(view.applications.find(row => row.id === application.id).manages, 'job management survives permission loss')
+    assert.deepEqual(view.scorecards.filter(row => row.application === application.id).map(row => row.id), [own.id], 'own-author exception survives; peer card is absent')
+    const denied = await bulk()
+    console.log('PROBE B1 bulk-preview then bulk-apply after peer access revocation: ' + JSON.stringify({
+      ownCardVisible: denied.scorecards.some(row => row.id === own.id), peerCardVisible: denied.scorecards.some(row => row.id === other.id),
+      retainedDebriefs: denied.debriefs.length, retainedRatings: denied.debriefs.flatMap(row => row.criteria.flatMap(k => k.ratings)) }))
+    assert.deepEqual(denied.debriefs, [], 'retained uncited peer ratings must not escape through bulk export')
+    assert.deepEqual(view.debriefs, [], 'workspace hides the same unauthorized retained brief')
+    assert.ok(!JSON.stringify(denied.debriefs).includes(other.id) && !JSON.stringify(denied.debriefs).includes(peerEmail))
+    await h.command('job-levels', { id: job.id, members: {} })
+    const restored = await bulk()
+    assert.deepEqual(restored.debriefs.map(row => row.id), [brief.id], 'restoring actual authority restores normal export')
+    assert.deepEqual(restored.debriefs[0].criteria, brief.criteria, 'privacy filtering never deletes retained evidence')
+  } finally { await h.close() }
+}
