{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "hiring/lodge",
    "name": "Lodge",
    "sourceRepository": "https://github.com/just-every/run-lodge",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm check:deployment-spec && pnpm exec rer check --profile first-party && pnpm run verify",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md: stop writes and scheduled work, retain exact source and private configuration, export the installation, restore into empty resources, run setup again and verify records, original document bytes and owner access before routing traffic. Preserve applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "INSTALLATION_KEY",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "INSTALLATION_KEY_PREVIOUS",
        "MAIL_API_KEY",
        "CAREERS_CF_API_TOKEN",
        "CAREERS_CF_ACCOUNT_ID",
        "CAREERS_CF_ZONE_ID",
        "CAREERS_CF_WORKER",
        "AI_ENABLED",
        "AI_MODEL",
        "AI_API_KEY",
        "AI_BASE_URL",
        "MODELS_SERVICE",
        "MODELS_KEY",
        "ENTERPRISE_OKTA_ISSUER",
        "ENTERPRISE_OKTA_CLIENT_ID",
        "ENTERPRISE_OKTA_CLIENT_SECRET",
        "ENTERPRISE_OIDC_SECRET",
        "ENTERPRISE_SCIM_TOKEN",
        "ENTERPRISE_SAML_ISSUER",
        "ENTERPRISE_SAML_ENTRY_POINT",
        "ENTERPRISE_SAML_CERTIFICATE"
      ],
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md: stop writes and scheduled work, retain exact source and private configuration, export the installation, restore into empty resources, run setup again and verify records, original document bytes and owner access before routing traffic. Preserve applied migration names and bytes.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
