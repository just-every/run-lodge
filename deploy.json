{
  "version": 1,
  "project": "hiring/lodge",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "auth@example.invalid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "INSTALLATION_KEY_PREVIOUS",
      "environment": "INSTALLATION_KEY_PREVIOUS",
      "optional": true
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "CAREERS_CF_API_TOKEN",
      "environment": "CAREERS_CF_API_TOKEN",
      "optional": true
    },
    {
      "binding": "CAREERS_CF_ACCOUNT_ID",
      "environment": "CAREERS_CF_ACCOUNT_ID",
      "optional": true
    },
    {
      "binding": "CAREERS_CF_ZONE_ID",
      "environment": "CAREERS_CF_ZONE_ID",
      "optional": true
    },
    {
      "binding": "CAREERS_CF_WORKER",
      "environment": "CAREERS_CF_WORKER",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
