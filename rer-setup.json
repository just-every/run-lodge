{
  "schema": 1,
  "title": "Lodge",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Installation mail"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Lodge",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#5a3a1e",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "Local development opens signed in as this owner; local mail is silently suppressed.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "INSTALLATION_KEY",
      "label": "Installation key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": true,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "development",
      "options": [
        {
          "value": "development",
          "label": "Local development (mail suppressed)"
        },
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      },
      "group": "mail"
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "setup-token",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN"
    }
  ]
}
